# Local development overrides for this plugin.
#
# Copy this file to `.env`, fill in the values, and edit away. `.env` is
# git-ignored; `.env.example` is the public template the team ships.
#
# Every key is optional unless marked required, and the shell environment always
# wins over this file, so a one-off run or CI job can override a single value
# without editing it:
#
#   $env:MINERAL_DEPLOY_WINDOWS_VAULT = "D:\vaults\other"   # PowerShell
#   export MINERAL_DEPLOY_WINDOWS_VAULT=/home/me/other      # bash

# ---------------------------------------------------------------------------
# sync-core vendoring
# ---------------------------------------------------------------------------

# Path to the source repository that holds `packages/sync-core/`.
# Used by `npm run sync-core:link` to rebuild the vendored tarball.
SYNC_CORE_SOURCE=../bedrock-mcp

# ---------------------------------------------------------------------------
# Deployment — shared
# ---------------------------------------------------------------------------

# Plugin id, i.e. the folder name under `<vault>/.obsidian/plugins/`.
# MINERAL_DEPLOY_PLUGIN_ID=mineral-obsidian-sync

# Artifacts copied into the plugin directory, space or comma separated. Files
# that do not exist are skipped unless they are main.js / manifest.json.
# MINERAL_DEPLOY_PLUGIN_FILES=main.js manifest.json styles.css

# Bundle mode: production (minified) or development (self-test harness kept).
# MINERAL_DEPLOY_BUILD=production

# Deployment target when none is passed on the command line: windows | android.
# MINERAL_DEPLOY_TARGET=windows

# ---------------------------------------------------------------------------
# Deployment — Windows / desktop vault      (required for `deploy-windows`)
# ---------------------------------------------------------------------------

# Absolute path to the vault root, NOT to the plugin directory. The script
# appends `.obsidian/plugins/<plugin id>` itself.
MINERAL_DEPLOY_WINDOWS_VAULT=C:\path\to\YourVault

# Stop a running Obsidian before copying (Windows only). The new bundle is not
# loaded until Obsidian reloads the plugin, so this avoids a silent no-op.
# MINERAL_DEPLOY_KILL_OBSIDIAN=true

# Relaunch Obsidian once the copy is verified.
# MINERAL_DEPLOY_RESTART_OBSIDIAN=true

# Desktop executable name to look for in the process list.
# MINERAL_DEPLOY_OBSIDIAN_PROCESS=Obsidian

# Create the plugin directory when the vault has never had the plugin installed.
# MINERAL_DEPLOY_CREATE_PLUGIN_DIR=true

# ---------------------------------------------------------------------------
# Deployment — Android                     (required for `deploy-android`)
# ---------------------------------------------------------------------------

# Vault name on the device, resolved under /sdcard/Documents/. An absolute device
# path such as /storage/emulated/0/Documents/mineral also works.
MINERAL_DEPLOY_ANDROID_VAULT=mineral

# ADB device serial. Leave unset when exactly one authorized device is attached.
# MINERAL_DEPLOY_ANDROID_SERIAL=

# adb executable; set a full path when adb is not on PATH.
# MINERAL_DEPLOY_ADB=C:\Users\me\AppData\Local\Android\Sdk\platform-tools\adb.exe

# Obsidian package id and launch activity on the device.
# MINERAL_DEPLOY_ANDROID_PACKAGE=md.obsidian
# MINERAL_DEPLOY_ANDROID_ACTIVITY=md.obsidian/.MainActivity

# Install into a fresh `<pluginId>-deploy-<version>-<stamp>` folder and repoint
# community-plugins.json. Android Obsidian caches the loaded bundle per plugin
# folder path, so this is the only reliable way to run a freshly pushed build.
# Defaults to true whenever a restart is requested.
# MINERAL_DEPLOY_ROTATE_PLUGIN_DIR=true

# Remove other enabled folders that declare the same plugin id. Two enabled
# folders with one manifest id both load, duplicating commands and handlers.
# Destructive, so it is off by default (`--prune` does the same for one run).
# MINERAL_DEPLOY_PRUNE_DUPLICATE_FOLDERS=true

# Per-command ADB timeout in milliseconds.
# MINERAL_DEPLOY_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# Deployment — switches
# ---------------------------------------------------------------------------

# Print the plan without building, writing, pushing or restarting anything.
# MINERAL_DEPLOY_DRY_RUN=true

# Reuse the bundle already on disk instead of rebuilding it.
# MINERAL_DEPLOY_SKIP_BUILD=true

# ---------------------------------------------------------------------------
# Optional real-R2 diagnostics (see docs/development.md)
# ---------------------------------------------------------------------------
# MINERAL_TEST_R2_ENDPOINT=
# MINERAL_TEST_R2_BUCKET=
# MINERAL_TEST_R2_ACCESS_KEY_ID=
# MINERAL_TEST_R2_SECRET_ACCESS_KEY=
# MINERAL_TEST_R2_PREFIX=
