# Local development overrides for this plugin.
#
# Copy this file to `.env`, fill in the paths, and edit away. `.env` is
# git-ignored; `.env.example` is the public template the team ships.
#
# The plugin reads these keys via scripts/vendor-sync-core.mjs.
# A missing key falls back to the CLI flag (`--from <path>`), which
# falls back to the `SYNC_CORE_FROM` shell environment variable.

# Path to the source repository that holds `packages/sync-core/`.
# Used by `npm run sync-core:link` to rebuild the vendored tarball.
# Example: "../bedrock-mcp" if the two repos share a parent directory.
SYNC_CORE_SOURCE=