{
  "name": "mineral-obsidian-sync",
  "version": "0.1.0",
  "description": "Read-only dry-run planner for R2-backed Obsidian vault sync.",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs development",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:ingress": "node scripts/verify-mutation-ingress.mjs",
    "sync-core:link": "node scripts/vendor-sync-core.mjs",
    "sync-core:link:dry-run": "node scripts/vendor-sync-core.mjs --dry-run",
    "deploy": "node scripts/deploy.mjs",
    "deploy:windows": "node scripts/deploy.mjs --target windows",
    "deploy:android": "node scripts/deploy.mjs --target android",
    "deploy:android:restart": "node scripts/deploy.mjs --target android --restart",
    "deploy:dry-run": "node scripts/deploy.mjs --dry-run"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.2",
    "obsidian": "^1.8.7",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "@mineral/sync-core": "file:vendor/mineral-sync-core-0.2.0.tgz",
    "aws4fetch": "^1.0.20",
    "node-diff3": "^3.2.1",
    "yjs": "^13.6.33"
  }
}
